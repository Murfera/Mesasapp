<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Nenhuma permissao declarada de proposito: o app e 100% local.
      Isso permite declarar "nenhum dado coletado" no formulario de
      Seguranca de Dados do Play Console. Compartilhar orcamento e QR do Pix
      usa ACTION_SEND, que nao exige permissao. O backup grava na pasta que o
      usuario escolhe pelo seletor do sistema, o que tambem nao exige permissao.
    -->

    <!--
      O WorkManager declara FOREGROUND_SERVICE por causa de "trabalho acelerado",
      recurso que o backup diario nao usa. Mantida no manifesto, ela obrigaria a
      declarar tipo de servico em primeiro plano e preencher o formulario
      correspondente no Play Console. Removida, some essa exigencia.

      Se algum dia o app passar a usar setExpedited(), esta linha precisa sair.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:name=".MesasappApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mesasapp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Mesasapp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
